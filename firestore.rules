rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return signedIn()
        && (request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'phone');
    }

    function isLandlord() {
      return verifiedUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'landlord';
    }

    function isSeeker() {
      return verifiedUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.role == 'seeker';
    }

    function ownsListing() {
      return signedIn()
        && resource.data.landlordId == request.auth.uid;
    }

    function validAverageRatingUpdate() {
      return verifiedUser()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['averageRating'])
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ['seeker', 'landlord'];

      allow read: if signedIn() && request.auth.uid == userId;

      allow update: if verifiedUser()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    match /dormitories/{dormitoryId} {
      allow get, list: if verifiedUser()
        && (resource.data.status == 'approved'
          || resource.data.landlordId == request.auth.uid);

      allow create: if isLandlord()
        && request.resource.data.landlordId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.monthlyPrice is number
        && request.resource.data.totalSlots is int
        && request.resource.data.availableSlots is int
        && request.resource.data.availableSlots >= 0
        && request.resource.data.availableSlots
          <= request.resource.data.totalSlots
        && request.resource.data.status == 'approved'
        && (!('landlordPhotoUrl' in request.resource.data)
          || request.resource.data.landlordPhotoUrl == null
          || (request.resource.data.landlordPhotoUrl is string
            && request.resource.data.landlordPhotoUrl.size() <= 2048
            && request.resource.data.landlordPhotoUrl.matches('^https://.*')));

      allow update: if (
        isLandlord()
        && ownsListing()
        && request.resource.data.landlordId == resource.data.landlordId
        && request.resource.data.status == resource.data.status
        && request.resource.data.availableSlots is int
        && request.resource.data.totalSlots is int
        && request.resource.data.availableSlots >= 0
        && request.resource.data.availableSlots
          <= request.resource.data.totalSlots
        && (!('landlordPhotoUrl' in request.resource.data)
          || request.resource.data.landlordPhotoUrl == null
          || (request.resource.data.landlordPhotoUrl is string
            && request.resource.data.landlordPhotoUrl.size() <= 2048
            && request.resource.data.landlordPhotoUrl.matches('^https://.*')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'address',
          'monthlyPrice',
          'availableSlots',
          'totalSlots',
          'amenities',
          'description',
          'photoUrls',
          'proximityLabel',
          'latitude',
          'longitude',
          'landlordName',
          'landlordPhone',
          'landlordPhotoUrl',
          'roomTypes',
          'utilitiesIncluded',
          'updatedAt'
        ])
      ) || validAverageRatingUpdate();

      allow delete: if isLandlord() && ownsListing();

      match /reports/{reporterId} {
        allow get: if signedIn() && request.auth.uid == reporterId;
        allow list: if false;

        allow create: if isSeeker()
          && request.auth.uid == reporterId
          && get(/databases/$(database)/documents/dormitories/$(dormitoryId))
            .data.status == 'approved'
          && get(/databases/$(database)/documents/dormitories/$(dormitoryId))
            .data.landlordId != request.auth.uid
          && request.resource.data.keys().hasAll([
            'reporterId',
            'reason',
            'details',
            'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'reporterId',
            'reason',
            'details',
            'createdAt'
          ])
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.reason in [
            'incorrect_information',
            'unavailable_property',
            'misleading_photos',
            'inappropriate_content',
            'suspicious_listing',
            'other'
          ]
          && request.resource.data.details is string
          && request.resource.data.details.size() <= 1000
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /reviews/{reviewId} {
        allow read: if verifiedUser()
          && (get(/databases/$(database)/documents/dormitories/$(dormitoryId))
                .data.status == 'approved'
            || get(/databases/$(database)/documents/dormitories/$(dormitoryId))
                .data.landlordId == request.auth.uid);

        allow create: if isSeeker()
          && reviewId == request.auth.uid
          && request.resource.data.authorUid == request.auth.uid
          && get(/databases/$(database)/documents/dormitories/$(dormitoryId))
            .data.status == 'approved'
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.authorName is string
          && request.resource.data.comment is string;

        allow update: if false;
        allow delete: if isLandlord()
          && get(/databases/$(database)/documents/dormitories/$(dormitoryId))
            .data.landlordId == request.auth.uid;
      }
    }
  }
}
